# ==========================================
# ZaykaDrop Production Environment Configuration
# ==========================================

# 1. Frontend & CORS
# In VPS / Nginx deployment, use your domain (e.g., https://yourdomain.com)
CLIENT_URL=https://yourdomain.com

# 2. Security Keys & Auth
JWT_SECRET=generate_a_very_long_random_jwt_secret_key_here
INTERNAL_SERVICE_KEY=generate_a_secure_internal_microservice_auth_key_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# 3. Database URLs
# MongoDB Atlas connection string (for Auth service)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ZaykaDrop?retryWrites=true&w=majority

# Neon Serverless PostgreSQL Connection String with pooling (as shown in your Neon Console)
# e.g., postgresql://neondb_owner:<password>@ep-delicate-cloud-bdt7uvra-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:<password>@ep-delicate-cloud-bdt7uvra-pooler.c-8.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true

# 4. Message Broker (CloudAMQP / Managed RabbitMQ)
# e.g., amqps://user:pass@clam.rmq.cloudamqp.com/vhost
RABBITMQ_URL=amqps://<user>:<password>@<host>/<vhost>

# 5. Cloudinary (Utils Image Upload Service)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

